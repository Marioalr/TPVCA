<?xml version="1.0" encoding="utf-8"?>
<!-- Solo en las compilaciones de depuración: una entrada aparte en el lanzador para la pantalla de desarrollo. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".dev.DevSyncActivity"
            android:exported="true"
            android:label="TPVC desarrollo"
            android:theme="@style/Theme.TPVCA">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".dev.PhoneDemoActivity"
            android:exported="true"
            android:label="TPVC celular demo"
            android:theme="@style/Theme.TPVCA">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
