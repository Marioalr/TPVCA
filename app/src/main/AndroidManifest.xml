<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Para Turso, solo con https:// (usesCleartextTraffic=false). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Solo para leer el QR de la PC; se pide al pulsar «Escanear». Sin cámara se pegan la URL y el token. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".TpvcaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TPVCA"
        android:usesCleartextTraffic="false"
        tools:targetApi="36">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TPVCA">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Sin telemetría de ML Kit. Estas tres piezas de datatransport llegan con la biblioteca y son las que suben sus eventos (FIREBASE_ML_SDK) desde
            este proceso a firebaselogging.googleapis.com. Sin ellas no hay backend ni trabajo que suba nada. ML Kit sigue leyendo: QrDecodingDeviceTest.
            Esto no alcanza a TelemetryLogging de Play Services, que va por otro camino: docs/SINCRONIZACION.md.
        -->
        <service android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery" tools:node="remove" />
        <service android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService" tools:node="remove" />
        <receiver android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver" tools:node="remove" />
    </application>

</manifest>
